<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleDisplayName</key><string>Sensor Read</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>9</string>
  <key>NSMotionUsageDescription</key><string>用于采集 Apple Watch 运动传感器数据。</string>
  <key>NSMicrophoneUsageDescription</key><string>用于同步采集 Apple Watch 麦克风音频，以进行多模态人体动作识别研究。</string>
  <key>NSHealthShareUsageDescription</key><string>用于在动作捕捉实验中读取心率、能量、距离和步态运动指标。</string>
  <key>NSHealthUpdateUsageDescription</key><string>用于创建运动会话，使手表可在息屏时持续采集传感器和运动指标。</string>
  <key>NSLocationWhenInUseUsageDescription</key><string>用于动作捕捉实验中同步采集 Apple Watch 的位置、速度、海拔和航向。</string>
  <key>NSNearbyInteractionUsageDescription</key><string>用于测量 Apple Watch 与配对 iPhone 之间的相对距离。</string>
  <key>WKApplication</key><true/>
  <key>WKCompanionAppBundleIdentifier</key><string>com.sensorread.ios</string>
  <key>WKRunsIndependentlyOfCompanionApp</key><true/>
  <key>WKBackgroundModes</key><array><string>audio</string><string>workout-processing</string></array>
</dict></plist>
